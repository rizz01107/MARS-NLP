def check_metric_traceability() -> None:
    """Every metric in final_results.csv must be reproducible from a raw predictions file."""
    from .data_loader import get_split, load_processed

    fin = pd.read_csv(R / "final_results.csv", keep_default_na=False)
    test = get_split(load_processed(), "test")
    labels = test.set_index("message_id")["label_id"]
    bp = pd.read_csv(R / "baseline_predictions.csv")
    bad, n_checked = [], 0
    cmap = {"Accuracy": "accuracy", "Precision": "precision_scam", "Recall": "recall_scam", "Macro_F1": "macro_f1", "Weighted_F1": "weighted_f1"}
    base_models = pd.read_csv(R / "baseline_results.csv").query("subset == 'Overall'")[["model_id", "model"]]
    name2id = dict(zip(base_models.model, base_models.model_id))
    ex = _executed_transformers()
    tx_names = {r["model"]: t for t, r in ex.items()}
    for _, row in fin.iterrows():
        if row["Status"] != "Executed":
            continue
        if row["Model"] in name2id:
            g = bp[bp.model_id == name2id[row["Model"]]]
            yt, yp = g["y_true"].values, g["y_pred"].values
        elif row["Model"] in tx_names:
            tp = pd.read_csv(R / f"transformer_predictions_{tx_names[row['Model']]}.csv")
            tp = tp[~tp.is_perturbed.astype(bool)]
            yp, yt = tp["y_pred"].values, tp["y_true"].values
            if not np.array_equal(labels.reindex(tp.message_id).values, yt) or set(tp.message_id) != set(labels.index):
                bad.append(f"{row['Model']}: predictions do not cover exactly the 935 test originals / labels differ")
                continue
        else:
            bad.append(f"{row['Model']}: Executed row without a result source")
            continue
        m = compute_metrics(yt, yp)
        for col, key in cmap.items():
            n_checked += 1
            try:
                mismatch = abs(float(row[col]) - round(m[key], 4)) > 1.5e-4
            except (TypeError, ValueError):
                mismatch = True
            if mismatch:
                bad.append(f"{row['Model']} {col}: table {row[col]} vs recomputed {m[key]:.4f}")
    add("metrics: every Executed row in final_results.csv recomputed from raw predictions", "PASS" if not bad else "FAIL",
        f"{n_checked} values checked" + ("" if not bad else "; " + "; ".join(bad[:4])))
    # robustness / subsets values vs source CSVs for transformers
    for tag, r in ex.items():
        row = fin[fin.Model == r["model"]].iloc[0]
        want = transformer_mean = None
        f = R / f"transformer_robustness_{tag}.csv"
        if f.exists():
            from .robustness import summarise

            want = round(float(summarise(pd.read_csv(f)).iloc[0]["mean_degradation"]), 4)
        try:
            okr = want is not None and abs(float(row["Robustness_Degradation"]) - want) < 1e-9
        except (TypeError, ValueError):
            okr = False
        add(f"metrics: transformer {tag} Robustness_Degradation traces to transformer_robustness_{tag}.csv", "PASS" if okr else "FAIL")
        del transformer_mean


