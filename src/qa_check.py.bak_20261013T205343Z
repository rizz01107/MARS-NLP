def check_streamlit_and_predictions(skip_server: bool) -> None:
    from .prediction import InvalidInput, available_models, load_predictor, predict_message

    models = available_models()
    if not models:
        add("prediction smoke tests", "FAIL", "no model available")
        return
    cases = [("English", "URGENT! You have won a prize. Call 09061234567 now."), ("Roman Urdu", "Aap ka account block ho gaya hai. PIN bhejein."),
             ("Urdu script", "آپ کا اکاؤنٹ بلاک ہو گیا ہے")]
    for name in sorted(models):
        try:
            pr = load_predictor(name)
            for _, txt in cases:
                r = predict_message(txt, pr)
                assert r.label in C.LABELS and 0 <= r.confidence <= 1
            for bad in ("", "   ", None):
                try:
                    predict_message(bad, pr)
                    raise AssertionError("empty input accepted")
                except InvalidInput:
                    pass
            add(f"prediction smoke test: {name}", "PASS", "English/Roman Urdu/Urdu ok; empty input rejected cleanly")
        except Exception as exc:
            add(f"prediction smoke test: {name}", "FAIL", f"{type(exc).__name__}: {exc}")
    try:
        from streamlit.testing.v1 import AppTest

        at = AppTest.from_file(str(C.ROOT_DIR / "app" / "app.py"), default_timeout=180).run()
        ok = not at.exception
        for txt in ["", "free prize call now", "Aap ka account block hai", "آپ کا اکاؤنٹ", "😀"]:
            at.text_area[0].set_value(txt).run()
            [b for b in at.button if b.label == "Analyse"][0].click().run()
            ok &= not at.exception
        add("Streamlit AppTest (load + 5 inputs, no exception)", "PASS" if ok else "FAIL")
    except Exception as exc:
        add("Streamlit AppTest", "FAIL", f"{type(exc).__name__}: {exc}")
    if skip_server:
        add("Streamlit headless server startup", "SKIP", "--skip-server")
        return
    port = 8597
    proc = subprocess.Popen([sys.executable, "-m", "streamlit", "run", "app/app.py", "--server.headless", "true", "--server.port", str(port)],
                            cwd=C.ROOT_DIR, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    status = "FAIL"
    try:
        for _ in range(40):
            time.sleep(1)
            try:
                if urllib.request.urlopen(f"http://localhost:{port}/_stcore/health", timeout=2).read().decode().strip() == "ok":
                    status = "PASS"
                    break
            except Exception:
                continue
    finally:
        proc.terminate()
        try:
            proc.wait(timeout=10)
        except Exception:
            proc.kill()
    add("Streamlit headless server startup (/_stcore/health == ok)", status)


