def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--skip-pytest", action="store_true")
    ap.add_argument("--skip-server", action="store_true")
    a = ap.parse_args(argv)
    RESULTS.clear()
    check_syntax_imports()
    if not a.skip_pytest:
        check_pytest()
    check_data_and_leakage()
    check_result_files()
    regenerate_outputs()
    check_metric_traceability()
    check_no_na_for_executed()
    check_reports()
    check_final_package()
    check_manuscript()
    check_streamlit_and_predictions(a.skip_server)
    core = [r for r in RESULTS if r.get("group", "core") == "core"]
    n = {s: sum(r["status"] == s for r in core) for s in ("PASS", "FAIL", "PENDING", "SKIP")}
    doc_n = {s: sum(r["status"] == s for r in RESULTS if r.get("group") == "documentation") for s in ("PASS", "FAIL")}
    ex = sorted(_executed_transformers())
    payload = {"summary": n, "documentation_checks_summary": doc_n, "transformers_executed": ex, "checks": RESULTS, "generated": time.strftime("%Y-%m-%d %H:%M:%S")}
    save_json(payload, T / "qa_report.json")
    lines = ["# QA report", "", f"Generated {payload['generated']}. PASS={n['PASS']} FAIL={n['FAIL']} PENDING={n['PENDING']} SKIP={n['SKIP']}. "
             f"Raw transformer run files present for: {ex or 'none'}.", "", "| Check | Status | Detail |", "|---|---|---|"]
    lines += [f"| {r['check']} | {r['status']} | {str(r['detail'])[:160]} |" for r in core]
    lines += ["", f"Documentation-wording checks (reported separately, not part of the counts above): PASS={doc_n['PASS']} FAIL={doc_n['FAIL']}", "", "| Check | Status | Detail |", "|---|---|---|"]
    lines += [f"| {r['check']} | {r['status']} | {str(r['detail'])[:160]} |" for r in RESULTS if r.get("group") == "documentation"]
    (T / "qa_report.md").write_text("\n".join(lines) + "\n", encoding="utf-8")
    rc, out = run_cmd([sys.executable, "-m", "src.make_gpu_review"])
    add("reports/FINAL_GPU_REVIEW.md generated", "PASS" if rc == 0 and (C.REPORTS_DIR / "FINAL_GPU_REVIEW.md").exists() else "FAIL", "" if rc == 0 else out[-200:])
    print(f"\nQA SUMMARY (core checks): PASS={n['PASS']} FAIL={n['FAIL']} PENDING={n['PENDING']} SKIP={n['SKIP']} | documentation-wording checks: PASS={doc_n['PASS']} FAIL={doc_n['FAIL']} | raw transformer run files present for: {ex or 'NONE'}")
    return 1 if any(r["status"] == "FAIL" for r in RESULTS) else 0


if __name__ == "__main__":
    sys.exit(main())
