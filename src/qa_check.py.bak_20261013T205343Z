def add(name: str, status: str, detail: str = "", group: str = "core") -> None:
    """``group='documentation'`` entries are reported separately and are NOT part of the core check counts."""
    RESULTS.append({"check": name, "status": status, "detail": detail, "group": group})
    print(f"[{status:7}] {name}" + (f" - {detail}" if detail else ""), flush=True)


def run_cmd(args: list[str], timeout: int = 1800) -> tuple[int, str]:
    p = subprocess.run(args, cwd=C.ROOT_DIR, capture_output=True, text=True, timeout=timeout)
    return p.returncode, (p.stdout + "\n" + p.stderr)[-3000:]


def _executed_transformers() -> dict:
    from .make_results import CANONICAL_TRANSFORMERS, load_transformer_result

    return {t: r for t in CANONICAL_TRANSFORMERS if (r := load_transformer_result(t)) is not None}


# --------------------------------------------------------------------------- individual checks
def check_syntax_imports() -> None:
    rc, out = run_cmd([sys.executable, "-m", "compileall", "-q", "src", "app", "tests"])
    add("syntax: compileall src/app/tests", "PASS" if rc == 0 else "FAIL", "" if rc == 0 else out[-300:])
    bad = []
    import src

    for m in pkgutil.iter_modules(src.__path__):
        try:
            importlib.import_module(f"src.{m.name}")
        except Exception as exc:
            bad.append(f"src.{m.name}: {type(exc).__name__}: {exc}")
    add("imports: every src module imports (no circular/broken imports)", "PASS" if not bad else "FAIL", "; ".join(bad))


def check_pytest() -> None:
    rc, out = run_cmd([sys.executable, "-m", "pytest", "-q", "-p", "no:cacheprovider"], timeout=3000)
    tail = out.strip().splitlines()[-1] if out.strip() else ""
    add("pytest -q", "PASS" if rc == 0 else "FAIL", tail)


def check_data_and_leakage() -> None:
    from .data_loader import load_processed
    from .splitting import check_group_leakage

    rc, out = run_cmd([sys.executable, "-m", "src.validate_data"])
    add("dataset validation (src.validate_data, exit code)", "PASS" if rc == 0 else "FAIL", "0 critical failures" if rc == 0 else out[-300:])
    df = load_processed()
    leak = check_group_leakage(df)
    ok = leak["groups_in_multiple_splits"] == 0 and leak["variants_with_split_different_from_original"] == 0
    add("leakage: no group in >1 split; every variant in its original's split", "PASS" if ok else "FAIL", str(leak))
    o = df[~df.is_perturbed.astype(bool)]
    sets = {s: set(o[o.split == s].cleaned_message) for s in C.SPLITS}
    overlap = len(sets["train"] & sets["test"]) + len(sets["train"] & sets["validation"]) + len(sets["validation"] & sets["test"])
    add("leakage: no exact text overlap between splits", "PASS" if overlap == 0 else "FAIL", f"{overlap} shared")
    expected = (C.PROCESSED_DIR / "mars_nlp_processed.sha256").read_text().split()[0]
    add("data: processed CSV checksum equals the audited file", "PASS" if sha256_file(C.PROCESSED_CSV) == expected else "FAIL")
    ref = json.loads((C.PROCESSED_DIR / "split_fingerprint.json").read_text())
    add("data: split fingerprints unchanged (test split not modified)", "PASS" if split_fingerprint(df) == ref else "FAIL")
    for tag, r in _executed_transformers().items():
        same = r.get("split_fingerprint") == ref and r.get("processed_csv_sha256") == expected
        add(f"transformer {tag}: trained/evaluated on the audited split & data", "PASS" if same else "FAIL")


